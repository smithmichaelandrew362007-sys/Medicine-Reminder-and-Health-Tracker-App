# CareSync Backend Configuration

# Server Port
PORT=3001

# Neon Serverless PostgreSQL Database Connection URL
# Replace with your own Neon connection string:
# Format: postgresql://[user]:[password]@[endpoint].neon.tech/[database]?sslmode=require
NEON_DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require
